# Content-addressed text artifacts and their builders must hash identically on Windows.
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.csv text eol=lf

# Frozen artifacts are byte-addressed; preserve their exact recorded bytes.
data/** -text
reports/** -text
outputs/** -text

# These trees are crawled/generated data, not source code — exclude them from
# GitHub's language detection so the repo reads as the Python project it is.
data/** linguist-vendored=true
reports/** linguist-generated=true
outputs/** linguist-generated=true

# Preserve the historical Windows source bytes bound by the two exempt manifests.
src/v3/question_router.py text eol=crlf
